# Что НЕ должно попадать в публичный релиз-архив (`git archive`, см.
# scripts/make-release.sh). git archive ИГНОРИРУЕТ .gitignore, поэтому
# tracked-, но внутренние/операционные файлы нужно отсекать ЗДЕСЬ через
# export-ignore — иначе они уедут в публичный tar.gz.
#
# КРИТИЧНО: внутренние доки содержат продакшн-инфраструктуру (адрес сервера,
# ssh-доступ, имя deploy-key, разборы безопасности). Их публикация через
# релиз-архив = раскрытие attack surface всему интернету.

# Вся внутренняя документация (аудиты, HANDOFF, планы, деплой-гайды и т.п.).
docs/** export-ignore
# ИСКЛЮЧЕНИЕ: USER-GUIDE.md — не документ для чтения, а рантайм-зависимость.
# Панель «Документация» в интерфейсе читает именно этот файл с диска
# (routes_docs.py: _DEFAULT_GUIDE_PATH), и без него кнопка отдаёт 404
# «guide not found». Регресс закрыт тестом в tests/test_installer.py.
docs/USER-GUIDE.md -export-ignore

# Тесты комьюнити не нужны для запуска, а их код содержит литералы прод-маркеров
# (для регресс-сканера) — их публиковать тоже не надо.
tests/** export-ignore
# Фронт-тесты лежат в web/src/__tests__ (вне tests/) — без этого они утекали в
# публичный tar.gz. Отсекаем и их.
web/src/__tests__/** export-ignore

# Дев-файлы в корне.
CLAUDE.md export-ignore

# Shell-скрипты ВСЕГДА с LF: CRLF из Windows-чекаута ломает bash на сервере
# (особенно shebang и `set` в первой строке). Касается и релиз-архива.
*.sh text eol=lf

# Регресс-защита: тест в tests/test_installer.py собирает архив и сканирует его
# на прод-маркеры (адрес сервера, имя deploy-key, ssh-пользователь) — падает,
# если хоть один просочился. Добавляя новый внутренний док/файл с такими
# данными, убедись, что он под export-ignore.
