#!/usr/bin/env bash
# Обёртка CLI в развёрнутой установке.
# Узнать адрес: ./scripts/vels url   (или `ai-panel url` после pip install -e .)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Обязательно из корня репозитория: `python -m src.cli` импортирует пакет `src`
# относительно CWD, поэтому без cd запуск из другого каталога падал бы с
# ModuleNotFoundError: No module named 'src'.
cd "$ROOT" || exit 1
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"
exec "$PY" -m src.cli "$@"
