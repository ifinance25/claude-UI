[Unit]
Description=Telegram Claude Code Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vels
Group=vels
WorkingDirectory=/home/vels/projects/telegram-claude-code
EnvironmentFile=/home/vels/projects/telegram-claude-code/.env
ExecStart=/home/vels/projects/telegram-claude-code/.venv/bin/python -m src.main

Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10
ExecStartPre=/bin/sleep 3

Environment=PYTHONUNBUFFERED=1

# Sandbox-хардеринг (поправьте ReadWritePaths под факт: install dir + HOME + projects).
ReadWritePaths=/home/vels/projects/telegram-claude-code /home/vels
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=telegram-claude-code

[Install]
WantedBy=multi-user.target
