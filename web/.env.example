# Build-time переменные фронтенда (Vite). При необходимости:  cp web/.env.example web/.env
#
# Имя Telegram-бота без @ — включает кнопку "Telegram Login" на странице входа.
# Необязательно: без него вход работает через команду /weblogin (magic-ссылка),
# виджет просто скрывается.
VITE_BOT_USERNAME=
